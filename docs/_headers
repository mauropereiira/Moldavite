# Security headers for every page, and a week of browser caching for
# images (rename a file when its content changes).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN

/far-hills.webp
  Cache-Control: public, max-age=604800

/far-hills-day.webp
  Cache-Control: public, max-age=604800

/near-hills.webp
  Cache-Control: public, max-age=604800

/near-hills-day.webp
  Cache-Control: public, max-age=604800

/moldavite-stone.webp
  Cache-Control: public, max-age=604800

/moldavite-stone-600.webp
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800

/icon.png
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

