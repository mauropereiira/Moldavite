{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Moldavite",
  "platforms": ["linux", "macOS", "windows"],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-destroy",
    "shell:default",
    "updater:default",
    "process:allow-restart",
    "dialog:default"
  ]
}
