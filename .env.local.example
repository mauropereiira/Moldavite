# Compile-time credentials. Copy to `.env.local` and fill in.
#
# `.env.local` is gitignored and must stay that way — these are read by
# `option_env!` when cargo compiles, so they end up inside the binary. That is
# unavoidable for an installed app and is why the OAuth flows do not rely on
# the secret staying secret. It is still not something to commit.
#
# Then: npm run dev:app

# https://developer.wordpress.com/apps/ — redirect URI moldavite://oauth/wordpress
MOLDAVITE_WPCOM_CLIENT_ID=145869
MOLDAVITE_WPCOM_CLIENT_SECRET=

# Google Cloud console — see issue #96
MOLDAVITE_GOOGLE_CLIENT_ID=
MOLDAVITE_GOOGLE_CLIENT_SECRET=
