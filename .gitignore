# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-ssr/
*.local

# Rust/Tauri build outputs
src-tauri/target/
# The iOS project is tracked (Info.plist, entitlements, the widget target);
# only its build products are not. Android is not generated yet.
src-tauri/gen/schemas/
src-tauri/gen/apple/assets/
src-tauri/gen/apple/Externals/
src-tauri/gen/apple/build/
src-tauri/gen/apple/Pods/
src-tauri/gen/apple/Podfile.lock
src-tauri/gen/apple/**/xcuserdata/
src-tauri/gen/android/

# IDE
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS files
.DS_Store
**/.DS_Store
Thumbs.db

# Development tools (not needed for users)
.claude/
.claudecode/
CLAUDE.md

# Temporary/backup files
*~
*.tmp
*.bak

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Local-only build-time credentials. src-tauri/.cargo/config.toml carries the
# development Google OAuth client via Cargo's [env]; release builds read it from
# Actions secrets instead. It already documents itself as uncommitted — this is
# the line that actually makes that true.
src-tauri/.cargo/

# TypeScript
*.tsbuildinfo

# Testing
coverage/
CLAUDE.local.md

# Local working files
AGENTS.md
AGENTS.local.md
sdd/
docs/superpowers/
.agents/
.qwen/
.playwright-mcp/
skills-lock.json

# Brand working files. Deliverables are copied to docs/ deliberately.
brand/

# Apple signing profiles are supplied locally or by CI, never committed.
*.provisionprofile
