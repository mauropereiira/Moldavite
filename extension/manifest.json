{
  "manifest_version": 3,
  "name": "Moldavite Clipper",
  "version": "0.1.0",
  "description": "Save the page you are reading as a Markdown note in Moldavite.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to Moldavite"
  },
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "clipper@moldavite.app",
      "strict_min_version": "128.0"
    }
  }
}
